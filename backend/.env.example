# Copy to backend/.env and adjust. Names only: never commit real values.

# Where the SQLite database and generated data live.
CD_DATA_DIR=./data
# Postgres instead of SQLite (optional):
# CD_DATABASE_URL=postgresql+psycopg://capital_drift:capital_drift@localhost:5432/capital_drift

# Demo bearer tokens: token:username:role, comma-separated. Roles: board_member, property_manager, admin.
CD_AUTH_TOKENS=board-token:bea:board_member,manager-token:max:property_manager,admin-token:adam:admin
CD_LOG_LEVEL=INFO
CD_LOG_JSON=false

# Claude invoice matching (`python -m app.cli match-llm`; live calls cost money).
# The SDK reads its own key: set ANTHROPIC_API_KEY here, or use an `ant auth login` profile.
# ANTHROPIC_API_KEY=
# CD_MATCH_LLM_PROVIDER=anthropic   # or bedrock (uses your AWS credentials)
# CD_MATCH_LLM_MODEL=claude-opus-5-5
# CD_MATCH_LLM_AWS_REGION=us-east-1
# CD_MATCH_LLM_EFFORT=low
# CD_MATCH_LLM_MAX_CALLS=10
